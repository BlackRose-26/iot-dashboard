{"nodes":[{"id":"docs_readme_documentation_index_and_authority","label":"Documentation index and authority","file_type":"document","source_file":"D:\\iot-dashboard\\docs\\README.md","source_location":"L7","source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"docs_readme_confirmed_stack_moko_baby_baseline","label":"Confirmed Stack Moko Baby baseline","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\README.md","source_location":"L31","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Name, LED matrix/button, private required student ID, React JavaScript/Vite and XAMPP MariaDB remain confirmed."},{"id":"docs_readme_current_implementation_update_supersedes_preview_assumptions","label":"Current implementation update supersedes preview assumptions","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\README.md","source_location":"L5","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Current QR/auth/persistent queue/admin themes supersede older preview/public assumptions. Physical ESP32 and AI provider integration remain future work."},{"id":"docs_readme_stack_intelligence_chat_design_with_deferred_live_analysis","label":"Stack Intelligence chat design with deferred live analysis","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\README.md","source_location":"L13","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Sticky bottom admin chat exists as local preview only; future questions cover event, IoT, dashboard, players, queue and scores."},{"id":"docs_admin_assistant_stack_intelligence_administrator_chat","label":"Stack Intelligence administrator chat","file_type":"document","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L1","source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"docs_admin_assistant_admin_only_fixed_bottom_shared_chat_dock","label":"Admin-only fixed bottom shared chat dock","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L7","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Authenticated Overview, Analytics, Queue, Sessions and Machine share the dock; absent from login/player pages. It expands/minimizes while shell stays mounted."},{"id":"docs_admin_assistant_accessible_preview_composer_focus_overlay_and_mobile_behavior","label":"Accessible preview composer focus overlay and mobile behavior","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L9","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Neutral light/dark/local font icons; six topic suggestions fill editable draft, labelled multiline input with character count, send/clear. Enter submits, Shift+Enter adds line, Escape minimizes/returns focus; empty/over1000character messages blocked. Nonmodal viewport-bounded overlay sits below menus/dialogs/alerts."},{"id":"docs_admin_assistant_memory_only_draft_and_conversation_lifecycle","label":"Memory-only draft and conversation lifecycle","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L7","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Minimize keeps current draft/conversation only while shell mounted. Refresh/signout clears preview; no transcript in browser storage or database. Component retains at most20messages."},{"id":"docs_admin_assistant_explicit_placeholder_replies_without_live_analysis_or_backend_calls","label":"Explicit placeholder replies without live analysis or backend calls","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L11","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Submission adds question and labelled preview reply; no provider, backend call, event retrieval, record change or invented real metric. Notice says Design preview Live analysis not connected. Deterministic cards remain separate."},{"id":"docs_admin_assistant_future_iot_cabinet_analytical_coverage","label":"Future IoT cabinet analytical coverage","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L19","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Authorized connection freshness, readiness, pending/review and available heartbeat fields. Separate device/simulator; missing telemetry remains unknown."},{"id":"docs_admin_assistant_future_dashboard_metric_definition_analytical_coverage","label":"Future dashboard metric-definition analytical coverage","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L20","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Explain definitions, denominators, filters, scope and differences between counts."},{"id":"docs_admin_assistant_future_aggregate_player_analytical_coverage_without_identity_access","label":"Future aggregate player analytical coverage without identity access","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L21","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Registration totals, distinct participants and completed-player counts with definitions. Public display labels resolved locally; no student IDs or identity material for AI."},{"id":"docs_admin_assistant_future_read_only_queue_and_admissions_analytical_coverage","label":"Future read-only queue and admissions analytical coverage","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L22","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Waiting totals, admissions, waiting reasons and recorded timing where data exists. Explain operator need without issuing action."},{"id":"docs_admin_assistant_future_source_separated_scores_results_and_level_analysis","label":"Future source-separated scores results and level analysis","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L23","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Valid distributions, top results, wins/losses, timeouts and levels separated by ruleset and source cohort."},{"id":"docs_admin_assistant_future_bounded_event_trends_and_cautious_comparisons","label":"Future bounded event trends and cautious comparisons","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L24","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Recorded time series, peak activity and comparisons require sample sizes and bounded scope."},{"id":"docs_admin_assistant_whole_authorized_event_means_analytical_coverage_not_control","label":"Whole authorized event means analytical coverage not control","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L26","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"No identity retrieval, arbitrary SQL, firmware execution or game mutations. Assistant remains read-only across all covered areas."},{"id":"docs_admin_assistant_deferred_staff_authenticated_conversation_endpoint","label":"Deferred staff-authenticated conversation endpoint","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L30","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Future endpoint requires staff auth, CSRF, strict payload validation and event permission boundary. This interface work implements no endpoint."},{"id":"docs_admin_assistant_deferred_normalized_intent_and_prewritten_aggregate_tools","label":"Deferred normalized intent and prewritten aggregate tools","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L31","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Normalize intent/filters server-side, block/redact private inputs before provider call. No dumps, credentials, identity hashes, unrestricted logs or arbitrary database query access."},{"id":"docs_admin_assistant_deferred_evidence_backed_scoped_answer_and_failure_states","label":"Deferred evidence-backed scoped answer and failure states","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L33","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Validate answers with source references, as-of time, denominators and missing/stale caveats. Loading/cancel/no-data/unavailable/refusal/retry states preserve draft on failure."},{"id":"docs_admin_assistant_deferred_provider_model_limits_and_separate_retention_decision","label":"Deferred provider model limits and separate retention decision","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L34","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Provider selection and request/token/cost/deadline limits remain pending under AI policy. Conversation persistence/retention would be separate explicit design; preview does neither."},{"id":"docs_admin_assistant_chat_interface_testing_deferred_at_user_request","label":"Chat interface testing deferred at user request","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\admin-assistant.md","source_location":"L36","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"No tests, builds, browser checks, database or hardware checks run for this UI change. Later integration still requires authorization/privacy/outage/numeric evidence checks."},{"id":"docs_ai_system_rules_proposed_analytics_v1_system_policy","label":"Proposed analytics-v1 system policy","file_type":"document","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L1","source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"docs_ai_system_rules_local_chat_preview_is_not_runtime_nlp_policy_enforcement","label":"Local chat preview is not runtime NLP policy enforcement","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L5","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Sticky chat preview does not call model, retrieve event data or enforce runtime NLP policy. Following rules apply to later integration."},{"id":"docs_ai_system_rules_read_only_staff_aggregate_analytics_boundary","label":"Read-only staff aggregate analytics boundary","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L11","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Future assistant may explain authorized event facts and suggest investigations, but cannot call/skip players, start/stop game, change difficulty/results/identity, contact players or execute arbitrary SQL/code."},{"id":"docs_ai_system_rules_server_scoped_authorized_event_ruleset_source_and_freshness","label":"Server-scoped authorized event ruleset source and freshness","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L66","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Server binds event, ruleset, timezone/window, permission and snapshot. Whole-event default does not silently inherit page chart filters. Every real answer displays actual scope/freshness and separates live observations from historic windows."},{"id":"docs_ai_system_rules_planned_allowlisted_event_score_level_trend_and_machine_tools","label":"Planned allowlisted event score level trend and machine tools","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L68","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Tool table specifies future integration, not implemented NLP endpoints: get_event_summary,get_top_scores,get_level_statistics,get_play_trend,get_machine_summary use bounded prewritten parameterized aggregates."},{"id":"docs_ai_system_rules_planned_get_queue_summary_aggregate_tool","label":"Planned get_queue_summary aggregate tool","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L75","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Waiting totals, admissions, cabinet eligibility and available timing under authorized scope. No private identity or queue mutation."},{"id":"docs_ai_system_rules_planned_get_score_distribution_aggregate_tool","label":"Planned get_score_distribution aggregate tool","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L76","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Approved buckets for selected ruleset/source yield valid completed-result counts and sample size; no invented/cross-cohort ranking."},{"id":"docs_ai_system_rules_quantitative_evidence_denominators_and_no_fabricated_telemetry","label":"Quantitative evidence denominators and no fabricated telemetry","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L37","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Numeric claims require tool/scope/time/sample refs. Distinguish registered versus completed players; exclude invalid/practice/etc from competition. Missing denominator is N/A, absent sensor data remains absent, small samples/correlation get caveats."},{"id":"docs_ai_system_rules_no_identity_credentials_or_nicknames_in_provider_context","label":"No identity credentials or nicknames in provider context","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L115","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"No student IDs, hashes/ciphertext, tokens or credentials to AI. Free-form nicknames excluded; resolve public codes locally. Redact private questions before external calls and avoid raw prompt/answer retention by default."},{"id":"docs_ai_system_rules_untrusted_strings_cannot_override_authorization_or_policy","label":"Untrusted strings cannot override authorization or policy","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L27","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Database strings, nicknames, retrieved text and attachments are data, not instructions. User messages cannot expand server authorization."},{"id":"docs_ai_system_rules_coherent_snapshots_and_distinct_machine_versus_result_times","label":"Coherent snapshots and distinct machine versus result times","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L95","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Use one read snapshot where feasible; multi-call answers share cutoff/snapshot or refetch/explain mismatch."},{"id":"docs_ai_system_rules_proposed_ai_deadlines_rate_and_budget_limits","label":"Proposed AI deadlines rate and budget limits","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L97","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"1000character question,5toolcalls,top10scores,168trendbuckets,20second deadline,10questions/minute proposed; enforce server budgets/bounded retries after provider choice."},{"id":"docs_ai_system_rules_quantitative_claims_and_metric_reference_validation","label":"Quantitative claims and metric-reference validation","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L113","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Validate output schema, facts/references and numeric claims. Prefer application formatting; reject unsupported claim and use deterministic fallback. Prompt alone is not verifier; escape text."},{"id":"docs_ai_system_rules_pending_ai_privacy_injection_and_failure_evaluations","label":"Pending AI privacy injection and failure evaluations","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L123","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Future release gates cover identity/control refusal, no data, timeouts, sample caveats, injected names, metric refs, provider failure and separate ruleset cohorts. These are requirements, not executed checks."},{"id":"docs_ai_system_rules_development_ai_and_graphify_evidence_boundaries","label":"Development AI and Graphify evidence boundaries","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\ai-system-rules.md","source_location":"L143","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Graphify/attachments cannot override user or prove tests/live state/approval. Maintain contracts, migrations and metrics together; no private data in graph."},{"id":"docs_dashboard_design_sourcio_adapted_dashboard_specification","label":"Sourcio-adapted dashboard specification","file_type":"document","source_file":"D:\\iot-dashboard\\docs\\dashboard-design.md","source_location":"L3","source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"docs_dashboard_design_admin_fixed_chat_preview_with_independent_analytical_scope","label":"Admin fixed chat preview with independent analytical scope","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\dashboard-design.md","source_location":"L7","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Bottom dock across authenticated dashboard pages, hidden on login/player. Neutral themes,font icons,nonmodal scrollable panel,topics/composer/clear/minimize. Preview replies only; chart filters are not automatically chat scope."},{"id":"docs_dashboard_design_player_reference_visual_language_and_source_limitations","label":"Player reference visual language and source limitations","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\dashboard-design.md","source_location":"L13","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Attached Sourcio gray/white/lime/blue composition guides layout/player styling; exact unseen fonts/tokens/source access not claimed. Current neutral admin palette overrides historical shared palette."},{"id":"docs_dashboard_design_rounded_cards_pill_rows_and_selective_accent_design_tokens","label":"Rounded cards pill rows and selective accent design tokens","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\dashboard-design.md","source_location":"L55","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Reference-derived spacing/corners/type and selective colors form visual baseline; preserve readable contrast, standard font symbols and textual chart equivalents."},{"id":"docs_dashboard_design_responsive_and_accessible_dashboard_behavior","label":"Responsive and accessible dashboard behavior","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\dashboard-design.md","source_location":"L75","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Responsive stacking, semantic controls/focus/non-color states and real freshness; unknown telemetry not fabricated. Current access update supersedes old public-leaderboard assumptions."},{"id":"docs_dashboard_design_design_acceptance_and_historical_preview_evidence_limits","label":"Design acceptance and historical preview evidence limits","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\dashboard-design.md","source_location":"L88","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Visual comparison and behavioral acceptance remain distinct. Old screenshot/sample notes are historical; chat work has not performed new browser/build checks."},{"id":"docs_implementation_plan_dependency_ordered_implementation_baseline_and_current_overrides","label":"Dependency-ordered implementation baseline and current overrides","file_type":"document","source_file":"D:\\iot-dashboard\\docs\\implementation-plan.md","source_location":"L3","source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"docs_implementation_plan_historical_preview_only_milestones_superseded_by_current_update","label":"Historical preview-only milestones superseded by current update","file_type":"rationale","source_file":"D:\\iot-dashboard\\docs\\implementation-plan.md","source_location":"L1","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Banner/current access documentation takes precedence over older preview-only backend statements."},{"id":"docs_implementation_plan_pending_physical_hardware_performance_and_recovery_acceptance","label":"Pending physical hardware performance and recovery acceptance","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\implementation-plan.md","source_location":"L9","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Actual panel/board/power/pins and playability still need physical validation; proposals not hardware evidence."},{"id":"docs_implementation_plan_implemented_stack_intelligence_ui_milestone_with_nlp_deferred","label":"Implemented Stack Intelligence UI milestone with NLP deferred","file_type":"concept","source_file":"D:\\iot-dashboard\\docs\\implementation-plan.md","source_l