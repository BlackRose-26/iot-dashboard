{
  "name": "stack-moko-baby-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "online": "node ../scripts/online.mjs",
    "online:firmware": "node ../scripts/online.mjs --firmware",
    "online:device": "node ../scripts/online.mjs --device",
    "device:selftest": "node ../scripts/device.mjs --selftest",
    "device:flash": "node ../scripts/device.mjs",
    "device:url": "node ../scripts/device.mjs url",
    "db:backup": "node ../scripts/device.mjs db --label manual",
    "db:verify": "node ../scripts/device.mjs db --verify",
    "dev": "node ../scripts/dev.mjs",
    "dev:frontend": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts e2e *.js *.json index.html"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "html5-qrcode": "2.3.8",
    "qr-scanner": "1.4.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
